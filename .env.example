# LRIDS Environment Configuration Template
# Copy to .env and configure for your local environment

APP_ENV=development
PORT=8000
FRONTEND_PORT=5173
LOG_LEVEL=INFO

# Operational Data Mode: REAL (Live Open-Meteo REST stream) or DEMO (Calibrated Western Ghats scenario)
DATA_MODE=REAL

# Database Connection (SQLite local or PostgreSQL enterprise)
DATABASE_URL=sqlite:///./landslide_risk.db

# JWT Authentication & RBAC
SECRET_KEY=change-this-in-production-use-strong-secret-key-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Telemetry Streams
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Decoupled Pipeline Paths
MODEL_ARTIFACTS_DIR=./ml_models
DATASETS_DIR=./data_pipeline/datasets\n