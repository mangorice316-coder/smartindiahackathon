# ==============================================================================
# AI-Powered Landslide Risk Intelligence & Early Warning System (LRIDS)
# Environment Configuration Template
# ==============================================================================

# Application Metadata
PROJECT_NAME="AI-Powered Landslide Risk Intelligence & Early Warning System"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Environment & Operating Mode
# Options: development | production | test
ENV=development

# Data Mode:
# DEMO: Isolated synthetic calibrated disaster scenario (Wayanad 2024 / Western Ghats)
# REAL: Ingests live telemetry from external meteorological & geotechnical APIs
DATA_MODE=DEMO

# Security & Cryptography
# [CRITICAL]: Change SECRET_KEY in production to a 64+ char random hex string
SECRET_KEY="generate-a-strong-random-secret-key-for-production-deployment-use-openssl-rand-hex-32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Strict Authentication Gate:
# Set to true to enforce signed JWT verification on all read/write endpoints
STRICT_AUTH=false

# Allowed CORS Origins (Comma-separated or JSON array)
ALLOWED_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:3000"]

# API Rate Limiting (Sliding Window In-Memory Gate)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_RPM=120
RATE_LIMIT_AUTH_RPM=15
RATE_LIMIT_SIMULATION_RPM=30

# Database Persistence
# Default: Local SQLite for self-contained zero-configuration execution
# Production: PostgreSQL (e.g. postgresql://user:password@localhost:5432/lrids_db)
DATABASE_URL="sqlite:///./landslide_risk.db"

# Risk Classification Thresholds (0.0 to 100.0 Scale)
# LOW: 0.0 - THRESHOLD_LOW_MAX
# MODERATE: THRESHOLD_LOW_MAX - THRESHOLD_MODERATE_MAX
# HIGH: THRESHOLD_MODERATE_MAX - THRESHOLD_HIGH_MAX
# CRITICAL: > THRESHOLD_HIGH_MAX
THRESHOLD_LOW_MAX=30.0
THRESHOLD_MODERATE_MAX=50.0
THRESHOLD_HIGH_MAX=70.0

# Geotechnical Limit Equilibrium Physics Parameters
# gamma_w: Unit weight of water (kN/m³)
WATER_UNIT_WEIGHT_KN_M3=9.81
FS_STABLE_THRESHOLD=1.3
FS_CRITICAL_THRESHOLD=1.0

# Field Inspection Urgency Priority Cutoffs (0.0 to 100.0 Score)
URGENCY_P1_IMMEDIATE=80.0
URGENCY_P2_HIGH=60.0
URGENCY_P3_MEDIUM=40.0

# Machine Learning Artifact Directory
MODEL_ARTIFACTS_DIR="./backend/model_artifacts"
